# ============================================================
# demo 阶段默认全 mock，开箱即跑
# ============================================================
LLM_PROVIDER=mock

# 模型名（demo 阶段所有 role 共用一个；切真 LLM 时必填）
#   - anthropic 直连：claude-sonnet-4-5 / claude-opus-4-1
#   - openai 直连：    gpt-4o / gpt-4o-mini
#   - NewAPI 网关：    "<provider>/<model>"，如 "anthropic/claude-sonnet-4-5"
LLM_WRITER_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.8

# ============================================================
# PostgreSQL — 与 docker-compose.yml 中的密码保持一致
# ============================================================
PG_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/auto_novels
PG_SYNC_DSN=postgresql+psycopg2://postgres:postgres@localhost:5432/auto_novels

# ============================================================
# API
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8082

# CORS（dev 用：vite 默认 5173，docker compose 用 8080）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ============================================================
# 真实 LLM 切换示例（保留 key 字段，默认不读）
# ============================================================

# ---- 直连 Anthropic ----
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ---- 直连 OpenAI ----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ---- NewAPI 网关（OpenAI 兼容协议）----
# LLM_PROVIDER=newapi
# NEWAPI_BASE_URL=https://your-newapi-domain/v1
# NEWAPI_API_KEY=sk-xxxxxxxxxxxxxx
# LLM_WRITER_MODEL=anthropic/claude-sonnet-4-5