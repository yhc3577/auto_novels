#!/usr/bin/env bash
# pre-push hook — 禁止任何 git push 到 origin/main
#
# 工作流约定：
#   - 默认开发分支：dev
#   - 日常 push：git push       (推到 origin/dev)
#   - main 分支：只在 GitHub 网页通过 PR / merge 更新
#     本仓库的 git push 一律禁止推到 origin/main
#     （包括 dev:main 的 refspec；如确需可临时 git push --no-verify）
#
# 激活：git config core.hooksPath .githooks

set -e

protected_branch='main'

while read -r local_ref local_sha remote_ref remote_sha; do
    # 只关心 main 分支
    if [ "$remote_ref" != "refs/heads/$protected_branch" ]; then
        continue
    fi

    # 同 SHA fast-forward：noop，允许（避免新 clone 后 push 报错）
    if [ "$local_sha" = "$remote_sha" ]; then
        continue
    fi

    echo "❌ 禁止 push 到 origin/$protected_branch"
    echo ""
    echo "约定：代码改动只推 origin/dev，main 由 GitHub PR/merge 更新。"
    echo ""
    echo "你刚才尝试："
    echo "  local : $local_ref  ($local_sha)"
    echo "  remote: $remote_ref ($remote_sha)"
    echo ""
    echo "正确做法（在 dev 分支开发）："
    echo "  git checkout dev"
    echo "  git push              # → origin/dev"
    echo ""
    echo "需要更新 main 时："
    echo "  - 推荐：开 PR 让 dev → main（GitHub 网页操作）"
    echo "  - 或：临时绕过本 hook（git push --no-verify）"
    exit 1
done

exit 0